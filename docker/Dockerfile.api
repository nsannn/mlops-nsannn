# docker/Dockerfile.api
# Inference API image: FastAPI + MLflow client. No model inside: it loads models:/tweet-emotion@champion
# from the MLflow registry at start-up. Build from the repo root:
#   docker build -f docker/Dockerfile.api -t <image>:sha-<commit> .
FROM python:3.12-slim-trixie AS base
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

FROM base AS builder
COPY requirements-api.txt .
RUN python -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r requirements-api.txt

FROM base AS runtime
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY src/serve.py ./src/
RUN useradd --uid 1000 --create-home api
USER 1000
EXPOSE 8000
CMD ["uvicorn", "serve:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8000"]
